# Copy this file to .env and fill in real values before running in anything
# other than a quick local demo.

ENVIRONMENT=development

# Leave as-is for a zero-setup local demo (creates ./aegispam.db automatically).
# For Postgres, e.g.: postgresql://aegispam_user:password@localhost:5432/aegispam_db
DATABASE_URL=sqlite:///./aegispam.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_DEV_ONLY_32_CHARACTERS_MIN

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=y2GqU9x1lF3iH8bT6mZ0nC4wA7dS2eR5vK1jP9oX3qY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
